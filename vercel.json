{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/:file([^/]+\\.[0-9a-f]{8}\\.(?:png|webp|svg|jpg|avif))",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/:file([^/]+\\.[0-9a-f]{8}\\.woff2)",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
